---
import '../styles/global.css';
import '@quorlansoftware/astro-web-components/styles/example.css';

interface Props {
  title: string;
  theme: 'bourbon' | 'neon' | 'minimal';
}

const { title, theme = 'bourbon' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Fonts: Cinzel for headings, Plus Jakarta Sans for body -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- FontAwesome Icons -->
  <!-- Preload fonts to avoid FOUT -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class={`theme-${theme}`}>
  <slot />
  
  <!-- Scripts Globales -->
  <script>
    // Inicializar Intersection Observer para animaciones tipo GTA 6
    document.addEventListener('DOMContentLoaded', () => {
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Opcional: Descomentar si solo quieres que se animen una vez
            // observer.unobserve(entry.target);
          } else {
            // Permite repetir la animación al hacer scroll arriba y abajo
            entry.target.classList.remove('is-visible');
          }
        });
      }, observerOptions);

      // Observar todos los elementos con clases reveal-*
      document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        observer.observe(el);
      });
    });
  </script>
</body>
</html>
