---
const theme = Astro.props.theme || 'bourbon';
const content = {
  bourbon: {
    s1Title: 'Corte "The Kentucky Fade"', s1Desc: 'El corte insignia de la casa. Degradado impecable, lavado con champú de cedro, fijación en mate.', s1Price: '28 €',
    s2Title: 'Ritual "Oak & Razor"', s2Desc: 'Esculpido de barba magistral, aplicación de aceite de almendras y afeitado tradicional a navaja.', s2Price: '22 €',
    s3Title: 'Experiencia "Bourbon & Blade"', s3Desc: 'Corte Kentucky + Ritual Oak & Razor. La experiencia completa con masaje capilar y degustación.', s3Price: '45 €'
  },
  neon: {
    s1Title: 'Corte "Vintage Fade"', s1Desc: 'Degradado perfecto con estilo clásico. Incluye lavado y estilismo final para la noche.', s1Price: '28 €',
    s2Title: 'Ritual "Retro Shave"', s2Desc: 'Afeitado con toalla caliente, masaje facial y aftershave clásico de la vieja escuela.', s2Price: '22 €',
    s3Title: 'Pack "Midnight Rider"', s3Desc: 'Corte Neon Fade + Ritual Retro Shave + Bebida de cortesía para arrancar el fin de semana.', s3Price: '45 €'
  },
  minimal: {
    s1Title: 'Corte "Pure Form"', s1Desc: 'Equilibrio y proporción. Incluye lavado con agua purificada e hidratación orgánica.', s1Price: '32 €',
    s2Title: 'Ritual "Zen Beard"', s2Desc: 'Tratamiento facial con esencias botánicas, recorte preciso y aceite de argán.', s2Price: '25 €',
    s3Title: 'Experiencia "Mindfulness"', s3Desc: 'Corte Pure Form, Ritual Zen Beard y masaje craneal con arcilla purificante. Relajación total.', s3Price: '50 €'
  }
};
const data = content[theme as keyof typeof content];
---
<section class="services section-padding" id="services">
  <div class="container">
    <div class="section-header text-center reveal-up">
      <span class="subheading">Nuestros Servicios</span>
      <h2 class="section-title">Precios &amp; Menú de Experiencias</h2>
      <div class="divider"></div>
    </div>

    <div class="services-grid grid-3">
      <!-- Service Card 1 -->
      <div class="service-card highlight reveal-up delay-100">
        <div class="service-badge">Más Popular</div>
        <div class="service-icon"><i class="fa-solid fa-scissors"></i></div>
        <h3 class="service-name">{data.s1Title}</h3>
        <p class="service-desc">{data.s1Desc}</p>
        <div class="service-meta">
          <span class="service-price">{data.s1Price}</span>
          <span class="service-time"><i class="fa-regular fa-clock"></i> 45 min</span>
        </div>
        <button class="btn btn-primary btn-block book-service-btn" data-service={data.s1Title}>Reservar</button>
      </div>

      <!-- Service Card 2 -->
      <div class="service-card reveal-up delay-200">
        <div class="service-icon"><i class="fa-solid fa-razor"></i></div>
        <h3 class="service-name">{data.s2Title}</h3>
        <p class="service-desc">{data.s2Desc}</p>
        <div class="service-meta">
          <span class="service-price">{data.s2Price}</span>
          <span class="service-time"><i class="fa-regular fa-clock"></i> 30 min</span>
        </div>
        <button class="btn btn-outline btn-block book-service-btn" data-service={data.s2Title}>Reservar</button>
      </div>

      <!-- Service Card 3 -->
      <div class="service-card reveal-up delay-300">
        <div class="service-icon"><i class="fa-solid fa-gem"></i></div>
        <h3 class="service-name">{data.s3Title}</h3>
        <p class="service-desc">{data.s3Desc}</p>
        <div class="service-meta">
          <span class="service-price">{data.s3Price}</span>
          <span class="service-time"><i class="fa-regular fa-clock"></i> 75 min</span>
        </div>
        <button class="btn btn-outline btn-block book-service-btn" data-service={data.s3Title}>Reservar</button>
      </div>
    </div>
  </div>
</section>

<style>
.service-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 35px 30px;
  border: 1px solid var(--border-color);
  position: relative;
  transition: var(--transition-smooth);
  display: flex;
  flex-direction: column;
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: var(--border-color);
  box-shadow: var(--shadow-glow);
}

.service-card.highlight {
  border-color: var(--primary-accent);
  background: var(--bg-card-hover);
}

.service-badge {
  position: absolute;
  top: -12px;
  right: 20px;
  background: var(--primary-accent);
  color: var(--bg-dark);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 20px;
  text-transform: uppercase;
}

.service-icon {
  font-size: 2rem;
  color: var(--primary-accent);
  margin-bottom: 20px;
}

.service-name {
  font-size: 1.3rem;
  margin-bottom: 12px;
}

.service-desc {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 25px;
  flex-grow: 1;
}

.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
  padding-top: 15px;
  border-top: 1px dashed var(--border-color);
}

.service-price {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--primary-accent);
  font-family: 'Cinzel', serif;
}

.service-time {
  font-size: 0.85rem;
  color: var(--text-muted);
}
</style>
