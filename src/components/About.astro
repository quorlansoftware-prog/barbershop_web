---
const theme = Astro.props.theme || 'bourbon';
const content = {
  bourbon: {
    img: '/assets/service.jpg',
    expNum: '1928', expText: 'Legado & Tradición',
    subheading: 'Nuestra Historia', title: 'El Arte de la Barbería Tradicional',
    p1: 'En BOURBON & BLADE rescatamos la esencia de las antiguas barberías clandestinas de los años 20. Un refugio donde el aroma a roble, el sonido de la navaja y el buen whiskey se unen.',
    p2: 'Cada caballero recibe un trato personalizado en nuestros sillones de cuero genuino restaurados. Trabajamos con ungüentos artesanales y aceites esenciales de cedro.',
    list1: 'Maestros barberos con décadas de experiencia', list2: 'Productos orgánicos de formulación propia', list3: 'Barra libre premium para clientes con reserva'
  },
  neon: {
    img: '/assets/service_neon.jpg',
    expNum: '1984', expText: 'Clásico & Pulcro',
    subheading: 'La Barbería Clásica', title: 'Auténtico Estilo Vintage',
    p1: 'En VINTAGE CUTS mantenemos vivo el oficio tradicional. Un espacio limpio, luminoso y con los colores emblemáticos de la verdadera barbería clásica.',
    p2: 'Cortes a navaja y arreglos de barba impecables, rodeados de una estética gráfica vintage que rinde homenaje a los maestros barberos de antaño.',
    list1: 'Sillones de barbero vintage restaurados', list2: 'Ambiente pulcro, clásico y relajado', list3: 'Afeitados tradicionales a toalla caliente'
  },
  minimal: {
    img: '/assets/service_minimal.jpg',
    expNum: '100%', expText: 'Bienestar & Paz',
    subheading: 'Nuestra Filosofía', title: 'Santuario Japandi',
    p1: 'En PURE STUDIO creemos que un corte de pelo debe ser una experiencia reparadora. Hemos diseñado un espacio estilo Japandi, cálido y minimalista, para escapar del estrés.',
    p2: 'Disfruta de luz natural, tonos arena y materiales nobles. Nuestro enfoque clínico garantiza higiene absoluta, mientras nuestros productos botánicos cuidan de tu piel y cabello.',
    list1: 'Espacio cálido, relajante y libre de ruido', list2: 'Cosmética capilar 100% vegana y botánica', list3: 'Estándares de higiene y pureza premium'
  }
};
const data = content[theme as keyof typeof content];
---
<section class="about section-padding alt-bg" id="about">
  <div class="container grid-2 align-center">
    <div class="about-img-wrapper reveal-left">
      <img src={data.img} alt="Barbero profesional trabajando" class="img-responsive rounded-img shadow-lg" />
      <div class="experience-badge">
        <span class="exp-number">{data.expNum}</span>
        <span class="exp-text">{data.expText}</span>
      </div>
    </div>
    <div class="about-content reveal-right">
      <span class="subheading">{data.subheading}</span>
      <h2 class="section-title">{data.title}</h2>
      <p class="lead-text" style="font-size: 1.1rem; margin-bottom: 15px;">
        {data.p1}
      </p>
      <p style="margin-bottom: 25px; color: var(--text-muted);">
        {data.p2}
      </p>

      <ul class="check-list">
        <li><i class="fa-solid fa-circle-check"></i> {data.list1}</li>
        <li><i class="fa-solid fa-circle-check"></i> {data.list2}</li>
        <li><i class="fa-solid fa-circle-check"></i> {data.list3}</li>
      </ul>
    </div>
  </div>
</section>

<style>
.about-img-wrapper {
  position: relative;
}

.rounded-img {
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
}

.experience-badge {
  position: absolute;
  bottom: -20px;
  right: -20px;
  background: var(--primary-accent);
  color: var(--bg-dark);
  padding: 20px 25px;
  border-radius: var(--radius-md);
  text-align: center;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.exp-number {
  font-size: 2rem;
  font-weight: 900;
  display: block;
  line-height: 1;
  font-family: 'Cinzel', serif;
}

.exp-text {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
}

.check-list {
  list-style: none;
  margin-top: 20px;
}

.check-list li {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  font-size: 0.95rem;
}

.check-list i {
  color: var(--primary-accent);
}
</style>
