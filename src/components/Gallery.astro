---
const theme = Astro.props.theme || 'bourbon';
const content = {
  bourbon: { img1: '/assets/hero.jpg', t1: 'Ambiente Exclusivo', d1: 'Instalaciones diseñadas para tu máximo confort', img2: '/assets/service.jpg', t2: 'Mid Fade & Beard', d2: 'Perfilado de barba y degradado fino' },
  neon: { img1: '/assets/hero_neon.jpg', t1: 'Vibra Nocturna', d1: 'Sillones ergonómicos y atmósfera synthwave', img2: '/assets/service_neon.jpg', t2: 'Líneas de Diseño', d2: 'Precisión absoluta bajo luces de neón' },
  minimal: { img1: '/assets/hero_minimal.jpg', t1: 'Espacio Zen', d1: 'Luz natural y diseño nórdico', img2: '/assets/service_minimal.jpg', t2: 'Precisión Pura', d2: 'Técnica detallada en un entorno aséptico' }
};
const data = content[theme as keyof typeof content];
// Gallery.astro
---
<section class="gallery section-padding" id="gallery">
  <div class="container">
    <div class="section-header text-center reveal-up">
      <span class="subheading">Galería de Estilos</span>
      <h2 class="section-title">Trabajos &amp; Barbería</h2>
      <div class="divider"></div>
    </div>

    <div class="gallery-grid">
      <div class="gallery-item main-item reveal-scale delay-100">
        <img src={data.img1} alt="Interior Barbería" />
        <div class="gallery-overlay">
          <h4>{data.t1}</h4>
          <p>{data.d1}</p>
        </div>
      </div>
      <div class="gallery-item reveal-scale delay-200">
        <img src={data.img2} alt="Corte" />
        <div class="gallery-overlay">
          <h4>{data.t2}</h4>
          <p>{data.d2}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.gallery-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  height: 400px;
}

.gallery-item {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30px;
  background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.gallery-overlay h4 {
  color: var(--text-main);
  margin-bottom: 5px;
}

.gallery-overlay p {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.gallery-item:hover img {
  transform: scale(1.05);
}

.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

@media (max-width: 992px) {
  .gallery-grid {
    grid-template-columns: 1fr;
    height: auto;
  }
  .gallery-item {
    height: 300px;
  }
}
</style>
