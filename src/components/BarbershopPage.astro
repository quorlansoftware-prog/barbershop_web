---
import Header from '@quorlansoftware/astro-web-components/Header.astro';
import Hero from '@quorlansoftware/astro-web-components/Hero.astro';
import Services from '@quorlansoftware/astro-web-components/Services.astro';
import About from '@quorlansoftware/astro-web-components/About.astro';
import Gallery from '@quorlansoftware/astro-web-components/Gallery.astro';
import Testimonials from '@quorlansoftware/astro-web-components/Testimonials.astro';
import Contact from '@quorlansoftware/astro-web-components/Contact.astro';
import Footer from '@quorlansoftware/astro-web-components/Footer.astro';
import BookingModal from '@quorlansoftware/astro-web-components/BookingModal.astro';
import { themes, type ThemeName } from '../data/themes';
interface Props { theme: ThemeName; }
const { theme } = Astro.props;
const data = themes[theme];
const asset = (path: string) => import.meta.env.BASE_URL + path;
const about = data.about;
---
<Header brand={data.brand} links={data.links} bookingTarget="booking">
  <i slot="logo" class="fa-solid fa-scissors" aria-hidden="true"></i>
</Header>
<main>
  <Hero eyebrow={data.hero.eyebrow} title={data.hero.title} description={data.hero.description} image={asset(data.hero.image)} imageAlt="Interior de la barbería" bookingTarget="booking" secondaryLabel="Ver servicios">
    <Fragment slot="title">{data.hero.title}<br /><span class="accent-text">{data.hero.titleAccent}</span></Fragment>
  </Hero>
  <Services eyebrow="Nuestros Servicios" title="Precios & Menú de Experiencias" services={data.services} bookingTarget="booking" />
  <About eyebrow={about.eyebrow} title={about.title} paragraphs={about.paragraphs} points={about.points} image={asset(about.image)} imageAlt="Barbero profesional trabajando" badgeValue={about.badgeValue} badgeLabel={about.badgeLabel} />
  <Gallery eyebrow="Galería de Estilos" title="Trabajos & Barbería" images={data.gallery.map((image) => ({ ...image, src: asset(image.src) }))} />
  <Testimonials eyebrow="Opiniones" title="Lo que dicen nuestros clientes" testimonials={data.testimonials} />
  <Contact eyebrow="Ubicación & Horarios" title="Ven a visitarnos" description="Puedes llamarnos directamente o reservar tu cita online." items={data.contact} />
</main>
<Footer brand={data.brand} description={data.description} links={data.links} copyright={`© 2026 ${data.brand}. Desarrollado para Quorlan Software.`}>
  <i slot="logo" class="fa-solid fa-scissors" aria-hidden="true"></i>
</Footer>
<BookingModal id="booking" title="Reservar cita online" description="Selecciona el servicio y el horario deseado" services={data.services} />
