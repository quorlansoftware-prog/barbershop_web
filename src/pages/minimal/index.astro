---
import Layout from '../../layouts/Layout.astro';
import SiteRenderer from '@quorlansoftware/astro-web-components/SiteRenderer.astro';
import siteConfig from '../../content/site.json';
const page = siteConfig.pages.find((item) => item.id === 'minimal');
---

<Layout title={page.metadata.title} description={page.metadata.description} theme="minimal" locale="es" canonical="/portfolio/minimal/" alternates={[{ locale: 'es', href: '/portfolio/minimal/' }, { locale: 'en', href: '/portfolio/en/minimal/' }]}>
  <SiteRenderer config={siteConfig} pageId="minimal" locale="es" />
</Layout>
