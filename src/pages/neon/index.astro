---
import Layout from '../../layouts/Layout.astro';
import SiteRenderer from '@quorlansoftware/astro-web-components/SiteRenderer.astro';
import siteConfig from '../../content/site.json';
const page = siteConfig.pages.find((item) => item.id === 'neon');
---

<Layout title={page.metadata.title} description={page.metadata.description} theme="neon" locale="es" canonical="/barbershop_web/neon/" alternates={[{ locale: 'es', href: '/barbershop_web/neon/' }, { locale: 'en', href: '/barbershop_web/en/neon/' }]}>
  <SiteRenderer config={siteConfig} pageId="neon" locale="es" />
</Layout>
