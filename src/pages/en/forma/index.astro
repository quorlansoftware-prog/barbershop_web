---
import Layout from '../../../layouts/Layout.astro';
import SiteRenderer from '@quorlansoftware/astro-web-components/SiteRenderer.astro';
import siteConfig from '../../../content/site.json';
const page = siteConfig.pages.find((item) => item.id === 'forma');
const metadata = { ...page.metadata, ...(page.metadata.translations?.en ?? {}) };
---

<Layout title={metadata.title} description={metadata.description} theme="forma" locale="en" canonical="/portfolio/en/forma/" alternates={[{ locale: 'es', href: '/portfolio/forma/' }, { locale: 'en', href: '/portfolio/en/forma/' }]}>
  <SiteRenderer config={siteConfig} pageId="forma" locale="en" />
</Layout>
