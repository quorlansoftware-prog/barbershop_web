---
import Layout from '../../../layouts/Layout.astro';
import SiteRenderer from '@quorlansoftware/astro-web-components/SiteRenderer.astro';
import siteConfig from '../../../content/site.json';
const page = siteConfig.pages.find((item) => item.id === 'bourbon');
const metadata = { ...page.metadata, ...(page.metadata.translations?.en ?? {}) };
---

<Layout title={metadata.title} description={metadata.description} theme="bourbon" locale="en" canonical="/portfolio/en/bourbon/" alternates={[{ locale: 'es', href: '/portfolio/bourbon/' }, { locale: 'en', href: '/portfolio/en/bourbon/' }]}>
  <SiteRenderer config={siteConfig} pageId="bourbon" locale="en" />
</Layout>
