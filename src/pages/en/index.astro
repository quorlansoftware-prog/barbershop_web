---
import siteConfig from '../../content/site.json';
const locale = 'en';
const source = siteConfig.site.catalog;
const catalog = { ...source, ...(source.translations?.[locale] ?? {}) };
const cards = source.cards.map((card) => ({ ...card, ...(card.translations?.[locale] ?? {}) }));
const pageUrl = (pageId) => `${import.meta.env.BASE_URL}${locale}/${siteConfig.pages.find((page) => page.id === pageId)?.path ?? ''}`;
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{catalog.title}</title><meta name="description" content={catalog.description} /><link rel="canonical" href="/barbershop_web/en/" /></head>
  <body>
    <header><h1>{catalog.title}</h1><p>{catalog.description}</p><a href="/barbershop_web/" lang="es">ES</a></header>
    <main>{cards.map((card) => <a href={pageUrl(card.pageId)} class:list={['card', `theme-${card.theme}`]}><img src={`${import.meta.env.BASE_URL}${card.image}`} alt={card.alt} /><span>{card.badge}</span><h2>{card.title}</h2><p>{card.description}</p><strong>{card.button}</strong></a>)}</main>
    <footer>{catalog.watermark}</footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; padding: 40px 20px; color: #fafafa; background: #09090b; font: 400 1rem/1.6 'Plus Jakarta Sans', sans-serif; }
  header, footer { max-width: 1200px; margin: 0 auto 48px; text-align: center; } header h1 { font-size: clamp(2.4rem, 6vw, 4rem); } header p { color: #a1a1aa; } header a { color: #fff; }
  main { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; max-width: 1200px; margin: 0 auto; }
  .card { display: flex; flex-direction: column; padding-bottom: 24px; overflow: hidden; color: inherit; text-decoration: none; background: #18181b; border: 1px solid #27272a; border-radius: 16px; } .card img { width: 100%; height: 220px; object-fit: cover; } .card > *:not(img) { margin-right: 24px; margin-left: 24px; } .card span { margin-top: 20px; color: #df9452; font-size: .8rem; font-weight: 700; text-transform: uppercase; } .card h2 { margin-bottom: 8px; } .card p { flex: 1; color: #a1a1aa; } .card strong { padding: 10px; text-align: center; background: #27272a; border-radius: 8px; }
</style>
