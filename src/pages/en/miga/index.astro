---
import Layout from '../../../layouts/Layout.astro';
import SiteRenderer from '@quorlansoftware/astro-web-components/SiteRenderer.astro';
import siteConfig from '../../../content/site.json';
const page = siteConfig.pages.find((item) => item.id === 'miga');
---

<Layout title={page.metadata.translations.en.title} description={page.metadata.translations.en.description} theme="miga" locale="en" canonical="/portfolio/en/miga/" alternates={[{ locale: 'es', href: '/portfolio/miga/' }, { locale: 'en', href: '/portfolio/en/miga/' }]}>
  <SiteRenderer config={siteConfig} pageId="miga" locale="en" />
</Layout>
